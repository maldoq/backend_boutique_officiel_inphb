# Valeurs FICTIVES uniquement (R13). Copier en .env puis renseigner les secrets.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=remplacer-par-une-cle-aleatoire-longue
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_ADMIN_URL=django-admin/

# --- Base de données ---
POSTGRES_DB=boutique_inphb
POSTGRES_USER=boutique
POSTGRES_PASSWORD=boutique
DATABASE_URL=postgres://boutique:boutique@localhost:5432/boutique_inphb

# --- URLs publiques ---
# domaine du site Angular (utilisé dans les QR)
PUBLIC_WEB_BASE_URL=http://localhost:4200
# URLs absolues hors requête (e-mails)
API_PUBLIC_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Règles métier ---
MAX_QTY_PER_LINE=10
MAX_LINES_PER_ORDER=30
# décision D06
STOCK_POLICY=reserve_on_order
QR_CODE_LENGTH=10
QR_SCAN_DEDUP_SECONDS=10
TRACKING_RETENTION_DAYS=730
DEFAULT_LOW_STOCK_THRESHOLD=3

# --- Mobile ---
MOBILE_MIN_SUPPORTED_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0

# --- Paiement (aucune vraie clé ici) ---
PAYMENT_PROVIDER=not_configured
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
MTN_MOMO_SUBSCRIPTION_KEY=
TRESOR_MONEY_API_KEY=

# --- Notifications ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=boutique@exemple.ci
SMS_PROVIDER=not_configured
WHATSAPP_PROVIDER=not_configured

# --- Données de démonstration (jamais commitées avec une valeur réelle) ---
DEMO_USERS_PASSWORD=
